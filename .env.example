# Backend propio OPCIONAL (solo para sincronización de favoritos).
# Si lo dejas vacío, la app funciona 100% con la API bíblica pública.
# En dispositivo físico usa la IP LAN del computador, por ejemplo:
# EXPO_PUBLIC_API_URL=http://192.168.1.7:3000
EXPO_PUBLIC_API_URL=

# --- Firebase Authentication ---
# Estos valores vienen de la consola de Firebase: Configuración del proyecto >
# Tus apps > SDK de configuración. Si los dejas vacíos, la app funciona en
# modo invitado (sin login).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
