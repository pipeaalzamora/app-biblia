# --- IA OPCIONAL (respaldo semántico de búsqueda) ---
# Déjalo vacío para usar solo la detección local de temas (gratis, sin servidor).
# Si lo configuras, debe apuntar a un endpoint POST que reciba { userInput } y
# devuelva { mensaje, versiculos:[{libro,capitulo,versiculo}] }.
# EXPO_PUBLIC_AI_URL=https://tu-backend.onrender.com/api/suggest-verses

# --- Firebase Authentication ---
# Estos valores vienen de la consola de Firebase: Configuración del proyecto >
# Tus apps > SDK de configuración. Si los dejas vacíos, la app funciona en
# modo invitado (sin login).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
